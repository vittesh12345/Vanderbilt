# SQLite database (zero-config local dev). Postgres works too — swap the
# provider in prisma/schema.prisma if you deploy.
DATABASE_URL="file:./dev.db"

# Optional: enables AI-powered syllabus extraction, study-plan narratives, and
# the chat interface. Without it, every feature still works using the built-in
# heuristic engines — AI simply enhances them.
# ANTHROPIC_API_KEY="sk-ant-..."
